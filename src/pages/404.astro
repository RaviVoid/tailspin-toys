---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ArrowLeft from '../assets/icons/arrow-left.svg';
---

<Layout title="페이지를 찾을 수 없습니다 - Tailspin Toys">
  <div class="py-16">
    <Card as="section" class="max-w-xl mx-auto text-center shadow-lg p-10" data-testid="not-found">
      <p class="text-6xl font-bold text-blue-400 mb-4">404</p>
      <h1 class="text-2xl font-semibold text-slate-100 mb-3" data-testid="not-found-heading">페이지를 찾을 수 없습니다</h1>
      <p class="text-slate-400 mb-8" data-testid="not-found-text">
        요청하신 페이지를 찾을 수 없습니다. 페이지가 삭제되었거나 주소가 잘못되었을 수 있습니다.
      </p>
      <Button href="/" data-testid="not-found-home-link">
        <ArrowLeft class="h-5 w-5 mr-2" aria-hidden="true" />
        모든 게임 보기
      </Button>
    </Card>
  </div>
</Layout>
