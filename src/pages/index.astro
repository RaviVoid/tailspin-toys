---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - 새로운 게임을 후원하세요!">
  <div class="py-8">
    <PageHero
      title="Tailspin Toys에 오신 것을 환영합니다"
      subtitle="새로운 게임을 찾아보고 마음에 드는 게임을 후원해 보세요. 지금 컬렉션을 살펴보세요!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">주목할 게임</h2>

      {games.length === 0 ? (
        <EmptyState text="현재 이용할 수 있는 게임이 없습니다." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
